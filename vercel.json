{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/api/(.*)", "dest": "/api/$1" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/presentacion$", "dest": "/Presentacion_CETECOM.html" },
    { "src": "^/remote$", "dest": "/remote.html" },
    { "src": "^/gantt$", "dest": "/Gantt_Interactivo_CETECOM.html" }
  ]
}
