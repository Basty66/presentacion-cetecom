{
  "version": 2,
  "routes": [
    { "src": "^/api/(.*)", "dest": "/api/$1" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/presentacion$", "dest": "/Presentacion_CETECOM.html" },
    { "src": "^/remote$", "dest": "/remote.html" },
    { "src": "^/gantt$", "dest": "/Gantt_Interactivo_CETECOM.html" }
  ]
}
